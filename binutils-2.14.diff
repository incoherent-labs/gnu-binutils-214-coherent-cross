diff -urN binutils-2.14-orig/ld/emulparams/i386coh.sh binutils-2.14/ld/emulparams/i386coh.sh
--- binutils-2.14-orig/ld/emulparams/i386coh.sh	Wed Dec 31 17:00:00 1969
+++ binutils-2.14/ld/emulparams/i386coh.sh	Tue May 19 19:35:45 2026
@@ -0,0 +1,20 @@
+# Inherit all baseline standard i386 COFF structural behaviors
+. ${srcdir}/emulparams/i386coff.sh
+
+# 1. Force the absolute memory location boundaries
+TEXT_START_ADDR=0xA8
+
+# 2. (Data VMA is handled by i386coff.sc: 0x400000 + (. & 0xffc00fff).
+#     Coherent libc uses hardcoded absolute addresses based at 0x400000;
+#     the physical file layout remains contiguous because COFF s_scnptr and
+#     s_vaddr are independent fields.)
+
+# 3. Force the linker generator to pack sections tightly without 4K page padding gap jumps
+TARGET_PAGE_SIZE=2
+FILE_ALIGNMENT=2
+
+# 4. Inform the template script to strip out modern compilation markers automatically
+FORCE_COMMON_ALLOCATION=yes
+
+# 5. Inject Coherent-specific runtime markers directly into the .bss section allocation
+OTHER_SECTIONS='PROVIDE (__end = .); PROVIDE (__end_bss = .);'

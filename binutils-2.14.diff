+++ binutils-2.14/bfd/coff-i386.c	Sun May 17 18:43:09 2026
@@ -47,7 +47,15 @@
 static reloc_howto_type *coff_i386_reloc_type_lookup
   PARAMS ((bfd *, bfd_reloc_code_real_type));
 
-#define COFF_DEFAULT_SECTION_ALIGNMENT_POWER (2)

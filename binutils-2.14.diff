+# define COFF_DEFAULT_SECTION_ALIGNMENT_POWER (1)  /* Strict 2**1 = 2-byte alignment */
+#else
+# define COFF_DEFAULT_SECTION_ALIGNMENT_POWER (2)  /* Fallback 2**2 = 4-byte baseline */
+#endif
+
 /* The page size is a guess based on ELF.  */
 
 #define COFF_PAGE_SIZE 0x1000
@@ -193,7 +201,7 @@
 #endif /* COFF_WITH_PE */
 
 #ifndef PCRELOFFSET
-#define PCRELOFFSET FALSE
+#define PCRELOFFSET FALSE 
 #endif
 
 static reloc_howto_type howto_table[] =

+++ binutils-2.14/bfd/coffcode.h	Sun May 17 08:27:53 2026
@@ -3948,7 +3948,10 @@
 
 #if defined(I386)
 #define __A_MAGIC_SET__
-#if defined(LYNXOS)
+/* Coherent header */
+#if defined(TARGET_COHERENT) || defined(COHERENT)
+      internal_a.magic = 0x010B;

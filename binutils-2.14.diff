diff -urN binutils-2.14-orig/bfd/cofflink.c binutils-2.14/bfd/cofflink.c
--- binutils-2.14-orig/bfd/cofflink.c	Sat Nov 30 01:39:36 2002
+++ binutils-2.14/bfd/cofflink.c	Fri Aug 28 14:01:00 2026
@@ -1973,7 +1973,16 @@
 	      union internal_auxent aux;
 	      union internal_auxent *auxp;
 
-	      if (h != NULL)
+	      /* Also bound by h->numaux.  h->aux is allocated only for the first
+	         symbol seen carrying aux entries (see ~line 550), so a 0-aux
+	         undefined reference encountered BEFORE a 1-aux definition leaves
+	         it NULL with h->numaux == 0 -- and h->aux + i then segfaults.
+	         This is what the BFD_ASSERT above is warning about; it used to
+	         warn and then crash anyway.  Trigger: ld's own error_handler,
+	         defined in ldmisc.o as a function (type 0x24, 1 aux) but
+	         referenced in ldmain.o as a decayed pointer (0x94, 0 aux).
+	         Only shows with -g, since aux entries carry the debug type.  */
+	      if (h != NULL && i < h->numaux)
 		auxp = h->aux + i;
 	      else
 		{
@@ -3020,6 +3029,51 @@
 		  return FALSE;
 		}
 	    }
+	}
+
+      /* PC-relative offset correction -- dual-convention aware.
+	 *
+	 * _bfd_final_link_relocate subtracts only (output_section->vma +
+	 * output_offset) from val, missing the reloc site's byte offset
+	 * within the section.  GAS-style objects (GCC/GAS 2.14 output)
+	 * store -4 in the displacement field; they require the correction
+	 *   val -= (r_vaddr - input_section->vma)
+	 * so the stored + relocation formula yields exactly sym_vma.
+	 *
+	 * The legacy Coherent assembler (MWC as) uses a different convention:
+	 * it pre-encodes -(r_vaddr + 4) in the displacement field so the
+	 * linker need only add the symbol VMA.  Applying the correction to
+	 * those objects would produce (sym_vma - r_vaddr) instead of sym_vma.
+	 *
+	 * Discriminant: COFF-style stored == -(r_vaddr + 4); GAS-style == -4.
+	 * Because r_vaddr >= 1 for any real CALL displacement field, these
+	 * two values can never coincide.  */
+      if (howto->pc_relative && !howto->pcrel_offset && !info->relocateable)
+	{
+	  bfd_signed_vma stored =
+	    (bfd_signed_vma) bfd_get_signed_32 (input_bfd,
+		contents + (rel->r_vaddr - input_section->vma));
+	  /* Three conventions reach this point, not two:
+	   *  (1) MWC objects:  stored == -(r_vaddr + 4)        -> skip
+	   *  (2) GAS section-relative (local) pcrel: the target is
+	   *      defined in THIS bfd and referenced through a section
+	   *      symbol (h == NULL, sym->n_scnum != 0).  GAS has already
+	   *      stored the fully-resolved intra-section displacement
+	   *      target-(site+4); applying the external-style correction
+	   *      would corrupt the field by the reloc's own section
+	   *      offset.                                        -> skip
+	   *  (3) GAS external (named symbol): stored == -4, linker must
+	   *      add the symbol VMA.                            -> correct
+	   */
+	  {
+	    bfd_boolean mwc_style =
+	      (stored == -((bfd_signed_vma) rel->r_vaddr + 4));
+	    bfd_boolean gas_local =
+	      (h == NULL && sym != NULL && sym->n_scnum != 0);
+	    if (!mwc_style && !gas_local)
+	      val -= rel->r_vaddr - input_section->vma;
+	  }
+
 	}
 
       rstat = _bfd_final_link_relocate (howto, input_bfd, input_section,
